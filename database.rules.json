{
  "rules": {
    ".read": false,
    ".write": false,
    "wheel": {
      "command": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['type', 'pool', 'id', 'sentAt']) && newData.child('type').val() === 'champion-carousel:spin' && newData.child('pool').exists()"
      }
    }
  }
}
